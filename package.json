{
  "name": "psychedelic-idea-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch src/server.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "check": "tsc --noEmit -p tsconfig.server.json && svelte-check --tsconfig tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@lucide/svelte": "^1.48.0",
    "better-sqlite3": "^12.2.0",
    "hono": "^4.9.0",
    "svelte": "^5.38.0",
    "uuid": "^14.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.0",
    "svelte-check": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
